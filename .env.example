# Production PostgreSQL Connection (leave unset to use local embedded PGlite at ./data/ihqa-pgdata)
DATABASE_URL=postgresql://postgres:password@localhost:5432/ihqa_kerala

# JWT Session Signing Secret (set a 32+ char random string in production)
AUTH_SECRET=replace-with-strong-production-secret

# LiveKit Cloud / Self-Hosted WebRTC (Recording/Egress stays disabled by design)
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret

# Optional SMS/OTP Gateway Webhook (if unset, sandbox OTP preview is returned in local dev)
SMS_GATEWAY_URL=
